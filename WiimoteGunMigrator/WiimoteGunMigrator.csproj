<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>WiimoteGunMigrator</RootNamespace>
    <!-- [3.1.5.10] EN: Named update_W4G.exe — the native self-updater that replaces
               WiimoteUpdate.ps1. Called by WiimoteGun.exe with the download URL + PID.
               FR: Nommé update_W4G.exe — l'auto-updateur natif qui remplace
               WiimoteUpdate.ps1. Appelé par WiimoteGun.exe avec l'URL + le PID. -->
    <AssemblyName>update_W4G</AssemblyName>
    <Version>1.0.0.0</Version>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

</Project>
