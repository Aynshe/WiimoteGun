<?xml version="1.0" encoding="utf-8"?>
<packages>
  <package id="System.Resources.Extensions" version="8.0.0" targetFramework="net48" />
  <!-- [V59-FIX-NUGET] EN: packages.config projects do NOT restore transitive
       dependencies — the SRE runtime chain must be declared explicitly
       (System.Memory → System.Buffers + Unsafe + Numerics.Vectors), otherwise
       a clean install crashes at the first embedded-resource access (tray icons).
       FR: Les projets packages.config ne restaurent PAS les dépendances transitives —
       la chaîne runtime de SRE doit être déclarée explicitement, sinon une
       installation propre plante au premier accès aux ressources embarquées. -->
  <package id="System.Buffers" version="4.5.1" targetFramework="net48" />
  <package id="System.Memory" version="4.5.5" targetFramework="net48" />
  <package id="System.Numerics.Vectors" version="4.5.0" targetFramework="net48" />
  <package id="System.Runtime.CompilerServices.Unsafe" version="6.0.0" targetFramework="net48" />
</packages>