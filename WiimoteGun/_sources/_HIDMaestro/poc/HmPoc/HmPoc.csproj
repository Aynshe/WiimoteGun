<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HmPoc</AssemblyName>
    <RootNamespace>HmPoc</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>CA1416;CS9191</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="HIDMaestro.Core">
      <HintPath>..\lib\HIDMaestro.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\lib\Microsoft.Windows.SDK.NET.dll" CopyToOutputDirectory="PreserveNewest" Link="Microsoft.Windows.SDK.NET.dll" />
    <None Include="..\lib\WinRT.Runtime.dll" CopyToOutputDirectory="PreserveNewest" Link="WinRT.Runtime.dll" />
  </ItemGroup>

</Project>
