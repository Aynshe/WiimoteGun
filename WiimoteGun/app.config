<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- [3.1.0.0-hotfix] EN: VS2022's GenerateResource stamps the compiled .resources
           manifests with the System.Resources.Extensions version bundled INSIDE MSBuild
           (6.0.0.0), while the deployed NuGet package (8.0.0) provides assembly 8.0.0.0.
           Without this redirect, ResourceManager calls (tray icons, embedded images)
           crash at startup with FileLoadException 0x80131040 when a release carries a
           different SRE version than the one the resources demand.
           FR: Le GenerateResource de VS2022 grave les manifests .resources compilés avec
           la version de System.Resources.Extensions embarquée DANS MSBuild (6.0.0.0),
           alors que le package NuGet déployé (8.0.0) fournit l'assembly 8.0.0.0. Sans
           cette redirection, les appels ResourceManager (icônes tray, images embarquées)
           plantent au démarrage avec FileLoadException 0x80131040 quand une release
           embarque une version de SRE différente de celle exigée par les ressources. -->
      <dependentAssembly>
        <assemblyIdentity name="System.Resources.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
