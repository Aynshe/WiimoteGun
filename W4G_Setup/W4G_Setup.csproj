<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>W4G_Setup</RootNamespace>
    <AssemblyName>W4G_Setup</AssemblyName>
    <Version>1.0.0.0</Version>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- [V61] EN: Assembly metadata (shown in file Properties > Details) -->
    <Product>Wiimote4Guns Setup</Product>
    <Company>Aynshe &amp; Team www.retrobat.org</Company>
    <Authors>Aynshe &amp; Team www.retrobat.org</Authors>
    <Copyright>© Aynshe &amp; Team www.retrobat.org</Copyright>
    <Description>Wiimote4Guns Setup — RetroBat Plugin Installer. https://github.com/Aynshe/WiimoteGun</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- [V61] EN: 7za.exe EMBEDDED as a resource — extracted to temp at runtime.
               The setup is fully standalone (no external file needed).
               FR: 7za.exe EMBARQUÉ comme ressource — extrait vers le temp au
               runtime. Le setup est totalement autonome (aucun fichier externe requis). -->
    <EmbeddedResource Include="7za.exe">
      <LogicalName>W4G_Setup.7za.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
